{
	"name": "@meetbryce/n8n-nodes-md-to-docs",
	"version": "1.0.1",
	"description": "n8n community node for Markdown to Google Docs conversion. Fork of n8n-nodes-md-to-docs with block-level markdown rendering in placeholder values.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"markdown",
		"google-docs",
		"google-drive",
		"document-generation"
	],
	"license": "MIT",
	"homepage": "https://github.com/meetbryce/n8n-nodes-md-to-docs#readme",
	"author": {
		"name": "Bryce York",
		"email": "bryce@meetbryce.com",
		"url": "https://github.com/meetbryce"
	},
	"contributors": [
		{
			"name": "Georgi Kyosev",
			"email": "g.kyosev86@gmail.com",
			"url": "https://github.com/GiK986"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meetbryce/n8n-nodes-md-to-docs.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.15"
	},
	"main": "dist/nodes/MarkdownToGoogleDocs/MarkdownToGoogleDocs.node.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "n8n-node dev",
		"dev:tsc": "tsc --watch",
		"format": "prettier nodes --write",
		"lint": "eslint nodes package.json",
		"lintfix": "eslint nodes package.json --fix",
		"prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes package.json"
	},
	"files": [
		"dist/nodes/**/*"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [],
		"nodes": [
			"dist/nodes/MarkdownToGoogleDocs/MarkdownToGoogleDocs.node.js"
		]
	},
	"dependencies": {
		"cheerio": "^1.1.2",
		"marked": "^16.0.0"
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.31.0",
		"@types/jsdom": "^21.1.7",
		"@typescript-eslint/parser": "~8.32.0",
		"esbuild": "^0.25.8",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"gulp": "^5.0.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "^3.5.3",
		"typescript": "^5.8.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
